<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>ASP.NET Core Web API + SignalR + Angular host. Can also run the background processor in-process; installable as a Windows Service.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FollowUp.Core\FollowUp.Core.csproj" />
    <ProjectReference Include="..\FollowUp.Integrations\FollowUp.Integrations.csproj" />
    <ProjectReference Include="..\FollowUp.AI\FollowUp.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <!-- The Angular UI is built into wwwroot by `npm run build` in client/ (the Docker image adds it in a later stage). -->
  <Target Name="WarnWhenUiNotBuilt" BeforeTargets="PrepareForPublish" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')">
    <Warning Text="wwwroot\index.html is missing: this publish contains the API but not the web UI. Run 'npm ci' and 'npm run build' in the client folder first (see docs/DEPLOY-IIS.md)." />
  </Target>

</Project>
