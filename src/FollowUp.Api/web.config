<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for FollowUp Officer (ASP.NET Core Module V2, in-process).
  %LAUNCHER_PATH% / %LAUNCHER_ARGS% are replaced by `dotnet publish` (dotnet + .\FollowUp.Api.dll, or the .exe for
  self-contained builds). Requires the .NET 10 Hosting Bundle on the server. See docs/DEPLOY-IIS.md.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        No <modules> section: IIS locks it by default (overrideModeDefault="Deny"), and any <modules> element here
        then fails with HTTP 500.19 / 0x80070021. When the WebDAV Publishing feature is installed, its module answers
        PUT and DELETE with 405; install-iis.ps1 removes it for this site in applicationHost.config instead.
      -->
      <handlers>
        <remove name="WebDAV" />
        <!-- Under an ASP.NET Core parent site this entry is inherited, and adding it again fails with HTTP 500.19. -->
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" startupTimeLimit="240" shutdownTimeLimit="30">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- Attachments are limited to 25 MB by the API; leave room for multipart overhead. -->
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
