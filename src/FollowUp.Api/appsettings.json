{
  "Urls": "http://localhost:5860",
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "FollowUp": "Server=(localdb)\\MSSQLLocalDB;Database=FollowUpOfficer;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "FollowUp": {
    "OrganisationName": "Wings Software",
    "PublicAppUrl": "http://localhost:5860",
    "SeedDemoData": true,
    "ShowDemoUsers": false,
    "SystemSenders": [ "followup@wings.example" ],
    "StoragePath": "data/attachments"
  },
  "Jobs": {
    "Enabled": true,
    "PollSeconds": 5,
    "MaxConcurrency": 4
  },
  "Microsoft365": {
    "Mode": "Emulator",
    "TenantId": "wings-demo",
    "ClientId": "followup-officer",
    "ClientSecret": "demo-secret",
    "PublicBaseUrl": "http://localhost:5860",
    "SenderMailbox": "followup@wings.example",
    "ServiceAccountUpn": "followup@wings.example",
    "MonitoredMailboxes": [ "ceo@wings.example", "followup@wings.example" ]
  },
  "Ai": {
    "Provider": "Heuristic"
  },
  "Entra": {
    "TenantId": "",
    "ClientId": "",
    "Audience": "",
    "ApiScope": ""
  },
  "Auth": {
    "LoginAttemptsPerMinute": 20
  },
  "Cors": {
    "Origins": [ "http://localhost:4860" ]
  },
  "Realtime": {
    "Enabled": true,
    "PollMilliseconds": 1000
  },
  "DataProtection": {
    "KeysPath": "data/keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
