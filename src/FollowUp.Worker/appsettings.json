{
  "ConnectionStrings": {
    "FollowUp": "Server=(localdb)\\MSSQLLocalDB;Database=FollowUpOfficer;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "FollowUp": {
    "OrganisationName": "Wings Software",
    "PublicAppUrl": "http://localhost:5860",
    "SeedDemoData": true,
    "SystemSenders": [ "followup@wings.example" ],
    "StoragePath": "../FollowUp.Api/data/attachments"
  },
  "Jobs": {
    "Enabled": true,
    "PollSeconds": 5,
    "MaxConcurrency": 4
  },
  "Microsoft365": {
    "Mode": "Emulator",
    "TenantId": "wings-demo",
    "ClientId": "followup-officer",
    "ClientSecret": "demo-secret",
    "PublicBaseUrl": "http://localhost:5860",
    "SenderMailbox": "followup@wings.example",
    "ServiceAccountUpn": "followup@wings.example",
    "MonitoredMailboxes": [ "anand@wings.example", "followup@wings.example" ]
  },
  "Ai": {
    "Provider": "Heuristic"
  },
  "DataProtection": {
    "KeysPath": "../FollowUp.Api/data/keys"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
